# ============================================================
# 環境變數範本（此檔會進版控，**只准放假值**）
# 實際值請填在 .env.local —— 該檔已被 .gitignore 排除，永遠不會上傳
# ============================================================

# ---------- Supabase ----------
# 位置：Supabase Dashboard → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# publishable / anon key：可公開，受 RLS 保護
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role key：**可繞過 RLS，等同資料庫最高權限**
# 只准放在伺服器端，絕不可出現在瀏覽器程式碼或版控
SUPABASE_SERVICE_ROLE_KEY=

# 資料庫直連字串 —— 選填。migration 走 Supabase SQL Editor 時不需要。
# 位置：專案首頁上方「Connect」按鈕 → Direct connection → URI
SUPABASE_DB_URL=

# ---------- L0 資料層 ----------
# 原始快照本機落地位置（P3 接上 Supabase 後仍保留為備份）
L0_DATA_ROOT=./data/raw

# ---------- LINE Messaging API（P8） ----------
# 位置：https://developers.line.biz/console/
#   Provider → 你的 Messaging API channel
#
# 長期 Channel access token：Messaging API 分頁最下方「Issue」
# ⚠️ 等同於「以你的官方帳號發訊息」的權限，外洩請立即 Reissue
LINE_CHANNEL_ACCESS_TOKEN=

# Channel secret：Basic settings 分頁
# ⚠️ webhook 簽章驗證用。外洩等於任何人都能偽造你的交易紀錄
#    寫進 append-only 的 user_records，而那是拔不掉的
LINE_CHANNEL_SECRET=

# 你自己的 User ID：Basic settings 分頁最下方「Your user ID」
# 格式為 U 開頭 + 32 碼十六進位。**不是** LINE ID，也不是 Channel ID
LINE_USER_ID=

# ============================================================
# ⛔ 絕對不要設 ANTHROPIC_API_KEY
# CLAUDE.md 規定：設了會讓排程任務全額計入 API pay-as-you-go，
# 本專案零 AI API 支出。
# ============================================================
