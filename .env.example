# ============================================================
# 環境變數範本（此檔會進版控，**只准放假值**）
# 實際值請填在 .env.local —— 該檔已被 .gitignore 排除，永遠不會上傳
# ============================================================

# ---------- Supabase ----------
# 位置：Supabase Dashboard → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# publishable / anon key：可公開，受 RLS 保護
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role key：**可繞過 RLS，等同資料庫最高權限**
# 只准放在伺服器端，絕不可出現在瀏覽器程式碼或版控
SUPABASE_SERVICE_ROLE_KEY=

# 資料庫直連字串（跑 migration 用）
# 位置：Project Settings → Database → Connection string → URI
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.xxxxxxxx.supabase.co:5432/postgres

# ---------- L0 資料層 ----------
# 原始快照本機落地位置（P3 接上 Supabase 後仍保留為備份）
L0_DATA_ROOT=./data/raw

# ---------- LINE（P8 才會用到，現在留空） ----------
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ============================================================
# ⛔ 絕對不要設 ANTHROPIC_API_KEY
# CLAUDE.md 規定：設了會讓排程任務全額計入 API pay-as-you-go，
# 本專案零 AI API 支出。
# ============================================================
